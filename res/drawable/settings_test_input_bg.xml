<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Focused / Selected state: vibrant accent stroke -->
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/settings_input_bg"/>
      <corners android:radius="14dp"/>
      <stroke android:width="1.8dp" android:color="@color/settings_accent"/>
    </shape>
  </item>
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/settings_input_bg"/>
      <corners android:radius="14dp"/>
      <stroke android:width="1.8dp" android:color="@color/settings_accent"/>
    </shape>
  </item>
  <!-- Normal idle state: distinct contrasting card surface and crisp border -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/settings_input_bg"/>
      <corners android:radius="14dp"/>
      <stroke android:width="1.5dp" android:color="@color/settings_input_border"/>
    </shape>
  </item>
</selector>
