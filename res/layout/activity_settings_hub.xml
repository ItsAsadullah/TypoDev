<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_bg"
    android:fitsSystemWindows="true">

  <!-- Sticky Top App Bar (Centered Symmetrical Modern Navigation) -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="@color/settings_appbar_bg"
      android:paddingLeft="12dp"
      android:paddingStart="12dp"
      android:paddingRight="12dp"
      android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/btn_settings_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:padding="9dp"
        android:src="@drawable/ic_ios_back"
        android:tint="@color/settings_back_btn"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Back"/>

    <TextView
        android:id="@+id/tv_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="TypoDev Settings"
        android:textSize="18.5sp"
        android:textStyle="bold"
        android:textColor="@color/settings_text_title"/>
  </RelativeLayout>

  <View
      android:layout_width="match_parent"
      android:layout_height="0.6dp"
      android:background="@color/settings_border"/>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@color/settings_bg"
      android:fillViewport="true"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="56dp">

      <!-- SECTION 1: INPUT & TYPING -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="16dp"
          android:layout_marginBottom="8dp"
          android:text="INPUT &amp; TYPING"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <!-- Keyboard Layout & Keys -->
        <LinearLayout
            android:id="@+id/card_pref_layout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_layout"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Layout"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="Keyboard Layout &amp; Keys"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="62dp"
            android:layout_marginStart="62dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/settings_border"/>

        <!-- Suggestions & Dictionaries -->
        <LinearLayout
            android:id="@+id/card_pref_suggestions"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_suggestions"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Suggestions"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="Suggestions &amp; Dictionaries"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="62dp"
            android:layout_marginStart="62dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/settings_border"/>

        <!-- My Snippets & Word Manager (Direct from Main Settings) -->
        <LinearLayout
            android:id="@+id/card_pref_snippets"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_clip_edit"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Snippets"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="My Snippets &amp; Word Manager"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="62dp"
            android:layout_marginStart="62dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/settings_border"/>

        <!-- Typing & Gestures -->
        <LinearLayout
            android:id="@+id/card_pref_typing"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_typing"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Typing"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="Typing &amp; Gestures"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>
      </LinearLayout>

      <!-- SECTION 2: LOOK & SOUND -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="8dp"
          android:text="LOOK &amp; SOUND"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <!-- Theme & Appearance -->
        <LinearLayout
            android:id="@+id/card_pref_theme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_style"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Theme"/>

              <TextView
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:layout_gravity="center_vertical"
                  android:layout_marginLeft="16dp"
                  android:layout_marginStart="16dp"
                  android:text="Theme Customizer"
                  android:textSize="15.5sp"
                  android:textStyle="bold"
                  android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="62dp"
            android:layout_marginStart="62dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/settings_border"/>

        <!-- Sound & Vibration -->
        <LinearLayout
            android:id="@+id/card_pref_feedback"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_sound"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Sound"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="Sound &amp; Vibration"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>
      </LinearLayout>

      <!-- SECTION 3: INTELLIGENCE & UTILITIES -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="8dp"
          android:text="INTELLIGENCE &amp; UTILITIES"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <!-- AI Assistant -->
        <LinearLayout
            android:id="@+id/card_pref_ai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_ai"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="AI"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="AI Assistant"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="62dp"
            android:layout_marginStart="62dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/settings_border"/>



        <!-- Clipboard Manager -->
        <LinearLayout
            android:id="@+id/card_pref_clipboard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_clipboard"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Clipboard"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="Clipboard Manager"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>
      </LinearLayout>

      <!-- SECTION 4: ABOUT & SYSTEM -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="8dp"
          android:text="ABOUT &amp; SYSTEM"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <!-- Try & Test Keyboard -->
        <LinearLayout
            android:id="@+id/card_pref_test"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_test"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="Test"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="Try &amp; Test Keyboard"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="62dp"
            android:layout_marginStart="62dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/settings_border"/>

        <!-- About TypoDev -->
        <LinearLayout
            android:id="@+id/card_pref_about"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:src="@drawable/ic_pref_info"
              android:tint="@color/settings_icon_tint"
              android:contentDescription="About"/>

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_gravity="center_vertical"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:text="About TypoDev"
              android:textSize="15.5sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="8dp"
              android:layout_marginEnd="8dp"
              android:text="v2.1.0"
              android:textSize="13.5sp"
              android:textColor="@color/settings_text_subtitle"/>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_gravity="center_vertical"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Navigate"/>
        </LinearLayout>
      </LinearLayout>

      <!-- Clean Minimal Footer -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:gravity="center"
          android:layout_marginTop="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TypoDev Keyboard • Privacy Focused"
            android:textSize="12sp"
            android:textColor="@color/settings_text_footer"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Free &amp; Open Source on GitHub"
            android:textSize="11sp"
            android:textColor="@color/settings_text_footer_sub"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
