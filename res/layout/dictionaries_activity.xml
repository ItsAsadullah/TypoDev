<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_bg"
    android:fitsSystemWindows="true">

  <!-- Sticky Top App Bar -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="@color/settings_appbar_bg"
      android:paddingLeft="12dp"
      android:paddingStart="12dp"
      android:paddingRight="12dp"
      android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/btn_dict_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:padding="9dp"
        android:src="@drawable/ic_ios_back"
        android:tint="@color/settings_back_btn"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Back"/>

    <TextView
        android:id="@+id/tv_dict_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Dictionaries &amp; Wordlists"
        android:textSize="18.5sp"
        android:textStyle="bold"
        android:textColor="@color/settings_text_title"/>
  </RelativeLayout>

  <View
      android:layout_width="match_parent"
      android:layout_height="0.6dp"
      android:background="@color/settings_border"/>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@color/settings_bg"
      android:fillViewport="true"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="56dp">

      <!-- LEXICON STATUS CARD -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:layout_marginTop="16dp"
          android:minHeight="76dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/settings_group_bg">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="24dp"
            android:layout_marginStart="24dp"
            android:gravity="center"
            android:text="📚"
            android:textSize="22sp"
            android:background="@drawable/settings_icon_box"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="FrostKeys Lexicon Hub"
              android:textSize="16sp"
              android:textStyle="bold"
              android:textColor="@color/settings_text_title"/>

          <TextView
              android:id="@+id/tv_external_stats"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Total Words Loaded: 0 words"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/settings_accent"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="Fast on-device vocabulary &amp; suggestions"
              android:textSize="12sp"
              android:textColor="@color/settings_text_subtitle"/>
        </LinearLayout>
      </LinearLayout>

      <!-- SECTION 1: INSTALLED WORDLISTS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="22dp"
          android:layout_marginBottom="8dp"
          android:text="INSTALLED WORDLISTS"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <TextView
            android:id="@+id/tv_no_dicts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No wordlists installed yet. Download or import one below!"
            android:textSize="13sp"
            android:textColor="@color/settings_text_subtitle"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/ll_installed_dicts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
      </LinearLayout>

      <!-- SECTION 2: QUICK DOWNLOADS (FROSTKEYS) -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="22dp"
          android:layout_marginBottom="8dp"
          android:text="QUICK DOWNLOADS (FROSTKEYS)"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <!-- Bengali Preset -->
        <LinearLayout
            android:id="@+id/btn_dl_bengali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <TextView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:gravity="center"
              android:text="🇧🇩"
              android:textSize="22sp"
              android:background="@drawable/settings_icon_box"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="12dp"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bengali Wordlist"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/settings_text_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="43.9k+ curated words • Bengali typing"
                android:textSize="12sp"
                android:textColor="@color/settings_text_subtitle"/>
          </LinearLayout>

          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:layout_marginLeft="12dp"
              android:layout_marginStart="12dp"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:padding="6dp"
              android:src="@drawable/ic_download"
              android:tint="@color/settings_accent"
              android:background="?android:attr/selectableItemBackgroundBorderless"
              android:contentDescription="Download"/>
        </LinearLayout>

        <!-- English AOSP Preset -->
        <LinearLayout
            android:id="@+id/btn_dl_en_aosp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <TextView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:gravity="center"
              android:text="🇬🇧"
              android:textSize="22sp"
              android:background="@drawable/settings_icon_box"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="12dp"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English AOSP Wordlist"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/settings_text_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Official AOSP lexicon • FrostKeys optimized"
                android:textSize="12sp"
                android:textColor="@color/settings_text_subtitle"/>
          </LinearLayout>

          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:layout_marginLeft="12dp"
              android:layout_marginStart="12dp"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:padding="6dp"
              android:src="@drawable/ic_download"
              android:tint="@color/settings_accent"
              android:background="?android:attr/selectableItemBackgroundBorderless"
              android:contentDescription="Download"/>
        </LinearLayout>

        <!-- English Standard Preset -->
        <LinearLayout
            android:id="@+id/btn_dl_en_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <TextView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:gravity="center"
              android:text="🇬🇧"
              android:textSize="22sp"
              android:background="@drawable/settings_icon_box"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="12dp"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English Standard Wordlist"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/settings_text_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Standard vocabulary for autocorrect &amp; suggestions"
                android:textSize="12sp"
                android:textColor="@color/settings_text_subtitle"/>
          </LinearLayout>

          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:layout_marginLeft="12dp"
              android:layout_marginStart="12dp"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:padding="6dp"
              android:src="@drawable/ic_download"
              android:tint="@color/settings_accent"
              android:background="?android:attr/selectableItemBackgroundBorderless"
              android:contentDescription="Download"/>
        </LinearLayout>
      </LinearLayout>

      <!-- SECTION 3: CUSTOM IMPORT & ACTIONS -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="22dp"
          android:layout_marginBottom="8dp"
          android:text="CUSTOM IMPORT &amp; ACTIONS"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <!-- Import Local File -->
        <LinearLayout
            android:id="@+id/btn_import_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <TextView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:gravity="center"
              android:text="📥"
              android:textSize="20sp"
              android:background="@drawable/settings_icon_box"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="12dp"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import Local File"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/settings_text_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Load .txt, .dic, or .gz files from device storage"
                android:textSize="12sp"
                android:textColor="@color/settings_text_subtitle"/>
          </LinearLayout>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_marginLeft="12dp"
              android:layout_marginStart="12dp"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Open"/>
        </LinearLayout>

        <!-- Custom URL -->
        <LinearLayout
            android:id="@+id/btn_custom_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <TextView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:gravity="center"
              android:text="🔗"
              android:textSize="20sp"
              android:background="@drawable/settings_icon_box"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="12dp"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import via Web URL"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/settings_text_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Direct link to GitHub, Gist, or raw text URL"
                android:textSize="12sp"
                android:textColor="@color/settings_text_subtitle"/>
          </LinearLayout>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_marginLeft="12dp"
              android:layout_marginStart="12dp"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="@color/settings_chevron"
              android:contentDescription="Open"/>
        </LinearLayout>

        <!-- Clear All -->
        <LinearLayout
            android:id="@+id/btn_clear_external"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

          <TextView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_marginLeft="24dp"
              android:layout_marginStart="24dp"
              android:gravity="center"
              android:text="🗑️"
              android:textSize="20sp"
              android:background="@drawable/settings_icon_box"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginLeft="16dp"
              android:layout_marginStart="16dp"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="12dp"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear All Custom Wordlists"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#FFFF4D4D"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Wipe all downloaded and imported vocabulary"
                android:textSize="12sp"
                android:textColor="@color/settings_text_subtitle"/>
          </LinearLayout>

          <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_marginLeft="12dp"
              android:layout_marginStart="12dp"
              android:layout_marginRight="20dp"
              android:layout_marginEnd="20dp"
              android:src="@drawable/ic_chevron_right"
              android:tint="#80FF4D4D"
              android:contentDescription="Action"/>
        </LinearLayout>
      </LinearLayout>

      <!-- SECTION 4: OFFLINE BINARY DICTIONARIES (.DICT) -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginTop="22dp"
          android:layout_marginBottom="4dp"
          android:text="OFFICIAL OFFLINE DICTIONARIES (.DICT)"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:textColor="@color/settings_text_section"/>

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginLeft="24dp"
          android:layout_marginStart="24dp"
          android:layout_marginRight="24dp"
          android:layout_marginEnd="24dp"
          android:layout_marginBottom="8dp"
          android:text="@string/dictionaries_from_internet"
          android:textSize="12.5sp"
          android:textColor="@color/settings_text_subtitle"/>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginLeft="16dp"
          android:layout_marginRight="16dp"
          android:background="@drawable/settings_group_bg">

        <typodev.keyboard.dict.DictionaryListView
            android:id="@+id/dict_list_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            device_locales="true"
            style="@style/dictionary_list_view"/>

        <View
            android:id="@+id/dict_list_divider"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:background="@color/settings_border"/>

        <typodev.keyboard.dict.DictionaryListView
            android:id="@+id/dict_list_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            device_locales="false"
            style="@style/dictionary_list_view"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
