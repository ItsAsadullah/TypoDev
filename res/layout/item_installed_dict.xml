<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

  <TextView
      android:id="@+id/tv_dict_icon"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_marginLeft="24dp"
      android:layout_marginStart="24dp"
      android:gravity="center"
      android:text="🇧🇩"
      android:textSize="22sp"
      android:background="@drawable/settings_icon_box"/>

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginLeft="16dp"
      android:layout_marginStart="16dp"
      android:layout_marginTop="12dp"
      android:layout_marginBottom="12dp"
      android:orientation="vertical">

    <TextView
        android:id="@+id/tv_dict_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15.5sp"
        android:textStyle="bold"
        android:textColor="@color/settings_text_title"/>

    <TextView
        android:id="@+id/tv_dict_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/settings_text_subtitle"
        android:layout_marginTop="3dp"/>
  </LinearLayout>

  <TextView
      android:id="@+id/btn_delete_dict"
      android:layout_width="wrap_content"
      android:layout_height="36dp"
      android:gravity="center"
      android:layout_marginLeft="12dp"
      android:layout_marginStart="12dp"
      android:layout_marginRight="20dp"
      android:layout_marginEnd="20dp"
      android:paddingLeft="10dp"
      android:paddingStart="10dp"
      android:paddingRight="10dp"
      android:paddingEnd="10dp"
      android:text="Delete"
      android:textSize="13.5sp"
      android:textStyle="bold"
      android:textColor="#FFFF4D4D"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:clickable="true"
      android:focusable="true"/>
</LinearLayout>
