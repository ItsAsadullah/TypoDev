<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:hardwareAccelerated="false"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard">

  <include layout="@layout/translate_bar" />

  <typodev.keyboard.suggestions.CandidatesView
      android:id="@+id/candidates_view"
      style="@style/candidates_view">

    <ImageView
        android:id="@+id/btn_toolbar_toggle"
        android:contentDescription="@string/toolbar_more_tools"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/round_icon_chip_bg"
        android:clickable="true"
        android:focusable="false"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_toolbar_grid" />

    <LinearLayout
        android:id="@+id/clipboard_suggestion_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
      <LinearLayout
          android:id="@+id/clipboard_suggestion_chip"
          android:layout_width="wrap_content"
          android:layout_height="30dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/toolbar_chip_active_bg"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="8dp"
          android:paddingEnd="4dp">
        <ImageView
            android:id="@+id/clipboard_suggestion_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_toolbar_clipboard"
            android:tint="#FFFFFF"
            android:layout_marginEnd="5dp" />
        <TextView
            android:id="@+id/clipboard_suggestion_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:text="Paste" />
        <TextView
            android:id="@+id/clipboard_suggestion_close"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:text="✕" />
      </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/autofill_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">
      <LinearLayout
          android:id="@+id/autofill_container"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:orientation="horizontal"
          android:gravity="center_vertical" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/password_autofill_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">
      <LinearLayout
          android:id="@+id/password_autofill_container"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/btn_autofill_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/toolbar_chip_active_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:id="@+id/ic_autofill_chip"
              android:layout_width="15dp"
              android:layout_height="15dp"
              android:src="@drawable/ic_toolbar_key"
              android:tint="#FFFFFF"
              android:layout_marginEnd="5dp" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Autofill"
              android:textColor="#FFFFFF"
              android:textSize="12.5sp"
              android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_generate_pwd_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/toolbar_chip_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:id="@+id/ic_generate_pwd_chip"
              android:layout_width="14dp"
              android:layout_height="14dp"
              android:src="@drawable/ic_toolbar_generate"
              android:tint="?attr/colorLabel"
              android:layout_marginEnd="5dp" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Generate"
              android:textColor="?attr/colorLabel"
              android:textSize="12sp" />
        </LinearLayout>
      </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/suggestions_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:fillViewport="true">
      <LinearLayout
          android:id="@+id/suggestions_container"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:orientation="horizontal"
          android:clipChildren="true"
          android:clipToPadding="true"
          android:gravity="center_vertical">
        <TextView android:id="@+id/candidates_emoji" style="@style/candidates_emoji" android:visibility="gone"/>
      </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/toolbar_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        android:scrollbars="none"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:visibility="gone">
      <LinearLayout
          android:id="@+id/toolbar_container"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:orientation="horizontal"
          android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/voice_live_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
      <ImageView
          android:id="@+id/tv_voice_live_icon"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:src="@drawable/ic_toolbar_mic"
          android:tint="?attr/colorLabel"
          android:layout_marginEnd="6dp" />
      <TextView
          android:id="@+id/tv_voice_live_text"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:singleLine="true"
          android:ellipsize="start"
          android:textSize="14sp"
          android:textColor="?attr/colorLabel"
          android:text="@string/voice_listening_hint" />
    </LinearLayout>

    <!-- Legacy hidden stubs so legacy code safely finds them without showing them -->
    <TextView android:id="@+id/candidates_lang_name" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <Button android:id="@+id/dictionary_switch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

    <FrameLayout
        android:id="@+id/btn_magic_autocomplete_container"
        style="@style/candidates_magic_button">
      <ImageView
          android:id="@+id/btn_magic_autocomplete"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerInside"
          android:src="@drawable/ic_toolbar_magic"
          android:tint="?attr/colorLabel"
          android:contentDescription="Magic Autocomplete" />
      <ProgressBar
          android:id="@+id/magic_autocomplete_progress"
          style="?android:attr/progressBarStyleSmall"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_gravity="center"
          android:visibility="gone"
          android:indeterminate="true" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btn_voice_punct_container"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical"
        android:layout_weight="0"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/voice_punct_chip_bg"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        android:contentDescription="@string/voice_punctuation_checkbox_desc">
      <CheckBox
          android:id="@+id/cb_voice_punctuation"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:clickable="false"
          android:focusable="false"
          android:minWidth="0dp"
          android:minHeight="0dp"
          android:buttonTint="?attr/colorLabel" />
      <TextView
          android:id="@+id/tv_voice_punct_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:text="। ,"
          android:textSize="11sp"
          android:textStyle="bold"
          android:textColor="?attr/colorLabel"
          android:includeFontPadding="false"
          android:paddingStart="1dp"
          android:paddingEnd="1dp" />
    </LinearLayout>

    <typodev.keyboard.voice.VoiceSpectrumButton
        android:id="@+id/btn_candidate_mic_container"
        style="@style/candidates_magic_button">
      <ImageView
          android:id="@+id/btn_candidate_mic"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerInside"
          android:src="@drawable/ic_toolbar_mic"
          android:tint="?attr/colorLabel"
          android:contentDescription="Voice Typing" />
    </typodev.keyboard.voice.VoiceSpectrumButton>
  </typodev.keyboard.suggestions.CandidatesView>

  <typodev.keyboard.ai.AiPromptBarView
      android:id="@+id/ai_prompt_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <typodev.keyboard.EmojiSearchBarView
      android:id="@+id/emoji_search_bar_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <typodev.keyboard.clipboard.ClipboardSearchBarView
      android:id="@+id/clipboard_search_bar_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <typodev.keyboard.clipboard.ClipboardAddBarView
      android:id="@+id/clipboard_add_bar_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <LinearLayout
      android:id="@+id/keyboard_wrapper"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/one_hand_left_panel"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

      <ImageView
          android:id="@+id/btn_one_hand_left_switch"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:scaleType="centerInside"
          android:src="@drawable/ic_one_hand_switch_left"
          android:background="@drawable/toolbar_chip_bg"
          android:contentDescription="Switch Side"
          android:clickable="true"
          android:focusable="true"
          android:padding="8dp"/>

      <View
          android:layout_width="match_parent"
          android:layout_height="16dp"/>

      <ImageView
          android:id="@+id/btn_one_hand_left_expand"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:scaleType="centerInside"
          android:src="@drawable/ic_one_hand_expand"
          android:background="@drawable/toolbar_chip_bg"
          android:contentDescription="Full Screen"
          android:clickable="true"
          android:focusable="true"
          android:padding="9dp"/>
    </LinearLayout>

    <typodev.keyboard.Keyboard2View
        android:id="@+id/keyboard_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <LinearLayout
        android:id="@+id/one_hand_right_panel"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

      <ImageView
          android:id="@+id/btn_one_hand_right_switch"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:scaleType="centerInside"
          android:src="@drawable/ic_one_hand_switch_right"
          android:background="@drawable/toolbar_chip_bg"
          android:contentDescription="Switch Side"
          android:clickable="true"
          android:focusable="true"
          android:padding="8dp"/>

      <View
          android:layout_width="match_parent"
          android:layout_height="16dp"/>

      <ImageView
          android:id="@+id/btn_one_hand_right_expand"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:scaleType="centerInside"
          android:src="@drawable/ic_one_hand_expand"
          android:background="@drawable/toolbar_chip_bg"
          android:contentDescription="Full Screen"
          android:clickable="true"
          android:focusable="true"
          android:padding="9dp"/>
    </LinearLayout>
  </LinearLayout>

  <typodev.keyboard.ai.AiPaneView
      android:id="@+id/ai_pane_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <typodev.keyboard.fancy.FancyPaneView
      android:id="@+id/fancy_pane_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <typodev.keyboard.clipboard.ClipboardPaneView
      android:id="@+id/clipboard_pane_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>

  <typodev.keyboard.suggestions.ToolsGridPaneView
      android:id="@+id/tools_grid_pane"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"/>
</LinearLayout>
