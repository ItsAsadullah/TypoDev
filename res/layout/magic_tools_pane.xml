<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
  <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_toolbar_ai" android:tint="#38BDF8" android:importantForAccessibility="no"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:text="AI Writing &amp; Vision Tools" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
  <ImageView android:id="@+id/btn_hub_settings" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_ai_settings" android:padding="10dp" android:contentDescription="@string/ai_magic_guide_settings" android:background="?android:attr/selectableItemBackgroundBorderless"/>
  <ImageView android:id="@+id/btn_hub_close" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_ai_back" android:tint="#94A3B8" android:padding="10dp" android:contentDescription="Back to keyboard" android:background="?android:attr/selectableItemBackgroundBorderless"/>
 </LinearLayout>
 <ScrollView android:id="@+id/hub_actions_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
 <Button android:id="@+id/btn_hub_guide" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:text="@string/ai_magic_guide_open" android:textAllCaps="false"/>
 <Button android:id="@+id/btn_hub_restore_draft" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:text="@string/ai_writing_restore_draft" android:textAllCaps="false" android:visibility="gone"/>
 <LinearLayout android:id="@+id/hub_guide" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:visibility="gone">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_magic_guide_body" android:textSize="13sp" android:textColor="#F1F5F9"/>
  <Button android:id="@+id/btn_hub_guide_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:text="@string/ai_magic_guide_settings" android:textAllCaps="false"/>
 </LinearLayout>

 <!-- Row 1: AI Assistant & Edit Text -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:id="@+id/card_action_ai_actions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginEnd="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_toolbar_ai" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI Assistant" android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="All AI tools &amp; prompts" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/card_action_writing" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginStart="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_edit" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edit &amp; Rewrite" android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Proofread or change tone" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>

 <!-- Row 2: Math Solver & Continue Writing -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:id="@+id/card_action_math_solver" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginEnd="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_math" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Math Solver" android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="গণিত সমাধান ও সূত্র" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/card_action_autocomplete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginStart="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_toolbar_magic" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Continue Writing" android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto-complete sentence" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>

 <!-- Row 3: Screen Scan & Recent Screenshot -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:id="@+id/card_action_screen_scan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginEnd="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_screen_scan" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture Screen" android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reply from live screen" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/card_action_screenshot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginStart="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_screenshot" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Screenshot Reply" android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use latest screenshot" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>

 <!-- Row 4: Copied Text Reply, Gallery Image & Image-to-Text -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:id="@+id/card_action_copied_reply" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginEnd="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_comment" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clipboard Reply" android:textColor="#F1F5F9" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reply to copied post" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/card_action_gallery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_gallery" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Photo Reply" android:textColor="#F1F5F9" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="From gallery" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/card_action_image_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:padding="8dp" android:layout_marginStart="3dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_content" android:tint="#38BDF8" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scan Text" android:textColor="#F1F5F9" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Image OCR" android:textColor="#94A3B8" android:textSize="10sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
 </LinearLayout></ScrollView>
</LinearLayout>
