<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

  <PreferenceCategory
      android:title="@string/pref_category_clipboard"
      android:layout="@layout/pref_category_header">
    <Preference
        android:key="otp_autofill_service"
        android:title="@string/otp_autofill_title"
        android:summary="@string/otp_autofill_summary" />
    <Preference android:key="otp_autofill_test"
        android:title="@string/otp_autofill_test_title"
        android:summary="@string/otp_autofill_test_summary" />
    <Preference android:key="otp_browser_settings"
        android:title="@string/otp_browser_title" android:summary="@string/otp_browser_summary" />
    <SwitchPreference
        android:key="clipboard_history_enabled"
        android:title="@string/pref_clipboard_history_enabled"
        android:summary="@string/pref_clipboard_history_enabled_summary"
        android:defaultValue="true"/>
    <ListPreference
        android:key="clipboard_history_duration"
        android:title="@string/pref_clipboard_history_duration"
        android:summary="%s"
        android:defaultValue="30"
        android:entries="@array/pref_clipboard_duration_entries"
        android:entryValues="@array/pref_clipboard_duration_values"/>
    <SwitchPreference
        android:key="clipboard_screenshot_autosave"
        android:title="@string/clipboard_auto_setting"
        android:summary="@string/clipboard_auto_setting_summary"
        android:persistent="false"/>
  </PreferenceCategory>

</PreferenceScreen>
